---
// A company mark rendered like a FigJam sticker: original colours, white outline, soft drop shadow.
import { markFor } from '../lib/util';

interface Props {
  slug: string;
  accent?: string;
  size?: string;
  name?: string;
  class?: string;
}

const { slug, size = '48px', name, class: cls } = Astro.props;
const mark = markFor(slug);
---

<span
  class:list={['sticker', cls]}
  style={`--size:${size}`}
  role={name ? 'img' : undefined}
  aria-label={name}
  aria-hidden={name ? undefined : 'true'}
  transition:name={`mark-${slug}`}
>
  {mark && <img src={mark.src} alt="" width={mark.width} height={mark.height} loading="lazy" decoding="async" />}
</span>

<style>
  .sticker {
    display: inline-grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    flex: none;
    filter: drop-shadow(1.5px 0 0 #fff) drop-shadow(-1.5px 0 0 #fff) drop-shadow(0 1.5px 0 #fff) drop-shadow(0 -1.5px 0 #fff)
      drop-shadow(0 2px 3px rgb(0 0 0 / 0.18));
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
