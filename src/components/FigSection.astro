---
// A FigJam section: soft container with its name on a tab at the top left.
interface Props {
  label: string;
  class?: string;
}
const { label, class: cls } = Astro.props;
---

<section class:list={['fsection', cls]} aria-label={label}>
  <h2 class="tab">{label}</h2>
  <slot />
</section>

<style>
  .fsection {
    position: relative;
    padding: 40px 24px 24px;
    border-radius: 20px;
    background: rgb(255 255 255 / 0.45);
    box-shadow: inset 0 0 0 1px var(--border);
    animation: section-in 460ms var(--spring) both;
  }
  .fsection + :global(.fsection) {
    margin-top: 28px;
  }
  @keyframes section-in {
    from {
      opacity: 0;
      translate: 0 10px;
    }
  }
  .tab {
    position: absolute;
    top: 12px;
    left: 14px;
    padding: 3px 9px;
    border-radius: 7px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    font-size: 12px;
    font-weight: 500;
  }
  @media (max-width: 560px) {
    .fsection {
      padding: 40px 14px 14px;
    }
  }
</style>
