---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/inter';
import '../styles/global.css';
import CanvasScene from '../components/CanvasScene.astro';
import { site } from '../lib/site';
import { url } from '../lib/util';

interface Props {
  title?: string;
  description?: string;
  layer: 'me' | 'ring' | 'company' | 'aside';
  /** Where Escape takes you. */
  up?: string;
  prev?: string;
  next?: string;
  /** Extra breadcrumb after Work, for company pages. */
  crumb?: string;
}

const { title, description, layer, up, prev, next, crumb } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.title}`;
const desc = description ?? `${site.name}, ${site.title.toLowerCase()} in ${site.city}. SaaS product design, close to the team that builds it.`;
const firstName = site.name.split(' ')[0];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url('/og.png'), Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#f4f4f3" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <ClientRouter />
  </head>
  <body>
    <CanvasScene />
    <header class="bar">
      <nav class="crumbs" aria-label="Breadcrumb">
        {layer === 'me' ? <span aria-current="page">{firstName}</span> : <a href={url('/')}>{firstName}</a>}
        {
          (layer === 'ring' || layer === 'company') && (
            <>
              <span class="sep" aria-hidden="true">/</span>
              {layer === 'ring' ? <span aria-current="page">Work</span> : <a href={url('/work')}>Work</a>}
            </>
          )
        }
        {
          crumb && (
            <>
              <span class="sep" aria-hidden="true">/</span>
              <span aria-current="page">{crumb}</span>
            </>
          )
        }
        {
          layer === 'aside' && title && (
            <>
              <span class="sep" aria-hidden="true">/</span>
              <span aria-current="page">{title}</span>
            </>
          )
        }
      </nav>
      <nav class="links" aria-label="Site">
        {layer !== 'aside' && <a class="pill" href={url('/about')}>About</a>}
        {site.email && <a class="pill" href={`mailto:${site.email}`}>Email</a>}
      </nav>
    </header>

    <main data-layer={layer} data-up={up} data-prev={prev} data-next={next}>
      <slot />
    </main>

    <script>
      import { navigate } from 'astro:transitions/client';

      // Keyboard: Escape goes up a layer, arrows move around it.
      addEventListener('keydown', (e) => {
        if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.altKey) return;
        if (document.querySelector('dialog[open]')) return;
        if ((e.target as HTMLElement).closest('input, textarea, [contenteditable]')) return;
        const main = document.querySelector<HTMLElement>('main[data-layer]');
        if (!main) return;
        const { up, prev, next, layer } = main.dataset;
        if (e.key === 'Escape' && up) navigate(up);
        else if (layer === 'company' && e.key === 'ArrowLeft' && prev) navigate(prev);
        else if (layer === 'company' && e.key === 'ArrowRight' && next) navigate(next);
        else if (layer === 'me' && e.key === 'ArrowRight' && next) navigate(next);
      });
    </script>
  </body>
</html>
